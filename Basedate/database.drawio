:11px;text-align:right;&#39;&gt;строка&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;commission_percent&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;число&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#2f7d4f;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="400" y="286" width="300" height="184" as="geometry"/></mxCell>
        <mxCell id="tbl_offer_segments" value="&lt;table style=&#39;border-collapse:collapse;width:100%;font-family:Helvetica;font-size:12px;&#39;&gt;&lt;tr style=&#39;background:#2f7d4f;color:#ffffff;font-weight:700;&#39;&gt;&lt;td colspan=&#39;2&#39; style=&#39;padding:5px 8px;border-bottom:1px solid #1c4f32;&#39;&gt;Сегменты_цена_площадь (real_estate_offer_segments)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#e6f2ea;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:700;border-bottom:1.5px solid #2f7d4f;&#39;&gt;id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#3f6e51;font-size:11px;text-align:right;border-bottom:1.5px solid #2f7d4f;&#39;&gt;PK, число&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:600;&#39;&gt;offer_id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div style=&#39;font-weight:600;&#39;&gt;число&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;&#39;&gt;N:1 -&gt; Офферы_недвижимость, CASCADE&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;label&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;object_class&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;room_count&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;price_min&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a
        <mxCell id="tbl_leads" value="&lt;table style=&#39;border-collapse:collapse;width:100%;font-family:Helvetica;font-size:12px;&#39;&gt;&lt;tr style=&#39;background:#2f7d4f;color:#ffffff;font-weight:700;&#39;&gt;&lt;td colspan=&#39;2&#39; style=&#39;padding:5px 8px;border-bottom:1px solid #1c4f32;&#39;&gt;Лиды (leads)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#e6f2ea;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:700;border-bottom:1.5px solid #2f7d4f;&#39;&gt;id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#3f6e51;font-size:11px;text-align:right;border-bottom:1.5px solid #2f7d4f;&#39;&gt;&lt;div&gt;PK, число&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;last_name&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;first_name&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;middle_name&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;phone&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка, NOT NULL&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;decision_maker&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;ЛПР: Для себя / Риэлтор&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;client_type&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;вид клиента (справочник clientType)&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;other_borrower&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;булево&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;NULL — неприменимо, true/false — ответ&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:600;&#39;&gt;source_id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;число&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;N:1 -&amp;gt; Источники, SET NULL&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;line_type&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка: Входящая/Исходящая&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;фикс. список, валидация на API&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:600;&#39;&gt;employee_id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;число&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt
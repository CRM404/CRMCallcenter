        <mxCell id="tbl_lead_sources" value="&lt;table style=&#39;border-collapse:collapse;width:100%;font-family:Helvetica;font-size:12px;&#39;&gt;&lt;tr style=&#39;background:#2f7d4f;color:#ffffff;font-weight:700;&#39;&gt;&lt;td colspan=&#39;2&#39; style=&#39;padding:5px 8px;border-bottom:1px solid #1c4f32;&#39;&gt;Источники_лидов (sources)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#e6f2ea;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:700;border-bottom:1.5px solid #2f7d4f;&#39;&gt;ID_Источника&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#3f6e51;font-size:11px;text-align:right;border-bottom:1.5px solid #2f7d4f;&#39;&gt;PK, число&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:600;&#39;&gt;ID_Площадки&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div style=&#39;font-weight:600;&#39;&gt;число, NOT NULL&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;&#39;&gt;N:1 -&gt; Рекламные_площадки, RESTRICT&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;root_source (Корневой источник)&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;Город_Регион&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;Статус&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка, NOT NULL — &quot;Активен&quot;/&quot;Неактивен&quot;/&quot;Архив&quot;/&quot;Актуализация&quot;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;
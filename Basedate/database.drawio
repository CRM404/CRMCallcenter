        <mxCell id="note_audit_partitions" value="Разрезана по месяцам: audit_log_2026_07 … audit_log_2027_08. Полки на год вперёд и на месяц назад заводятся при каждом старте, горизонт отодвигается сам. Отдельными сущностями секции не рисуются — это одна таблица." style="shape=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#8a8f98;fillColor=#f7f8fb;spacing=6;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1960" y="2940" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="edge_audit_log_batch" value="N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#8a3c2a;fontSize=10;fontColor=#8a3c2a;" edge="1" parent="1" source="tbl_audit_log" target="tbl_audit_batches"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_audit_batches_emp" value="N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#8a3c2a;fontSize=10;fontColor=#8a3c2a;" edge="1" parent="1" source="tbl_audit_batches" target="tbl_employees"><mxGeometry relative="1" as="geometry"/></mxCell>

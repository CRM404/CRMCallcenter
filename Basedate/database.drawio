&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;line_type&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка: Входящая/Исходящая&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;work_schedule&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка, nullable, поле «Дни» (5/2)&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;справочно: в расчёте графика не участвует&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;shift_start&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;время, nullable&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;личное время смены; пусто = месяц разом не заполнить&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;shift_end&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;время, nullable&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;меньше shift_start = ночная смена&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;password&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;country&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;registration&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;passport_series&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;passport_number&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;issued_by&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;issue_date&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;Дата&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;inn&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;bank&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;account&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;on_line&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;да/нет, ручной переключатель оператора&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;on_line_since&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;дата-время, очередь раздачи&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;work_state&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;off / on_line / break / lunch / training / review&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;released_lead_notice&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;булево&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;разовое «лид вернулся в общую очередь»&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;pbx_extension&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка, nullable&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;добавочный на АТС; уникален среди неархивных (частичный индекс)&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;pbx_extension_id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка, nullable&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;служебный id расширения в АТС; человеку не показывается&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;pbx_password&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка, nullable&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;пароль АТС; с карточкой наружу не отдаётся, только отдельной точкой&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;tunnel_public_key&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка, nullable&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;открытый ключ клиента; появляется в момент ОТКРЫТИЯ ссылки. Закрытого у нас нет нигде&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;tunnel_address&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка, nullable&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;адрес в подсети туннеля; уникален среди неотозванных (частичный индекс)&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;tunnel_issued_at&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;дата-время, nullable&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:600;&#39;&gt;tunnel_issued_by&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;число, nullable&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;N:1 -&amp;gt; Сотрудники, SET NULL. Пока входа нет — всегда пусто, в карточке прочерк&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;tunnel_revoked_at&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;дата-время, nullable&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;ставится архивом и перевыпуском; отзыв ОСВОБОЖДАЕТ адрес&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;tunnel_key_at&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;дата-время, nullable&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;когда родилась пара, то есть когда сотрудник открыл ссылку&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#2f7d4f;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="1120" y="40" width="300" height="999" as="geometry"/></mxCell>
        <mxCell id="tbl_employee_state_intervals" value="&lt;table style=&#39;border-collapse:collapse;width:100%;font-family:Helvetica;font-size:12px;&#39;&gt;&lt;tr style=&#39;background:#2f7d4f;color:#ffffff;font-weight:700;&#39;&gt;&lt;td colspan=&#39;2&#39; style=&#39;padding:5px 8px;border-bottom:1px solid #1c4f32;&#39;&gt;employee_state_intervals (таймеры состояний)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#e6f2ea;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:700;border-bottom:1.5px solid #2f7d4f;&#39;&gt;id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#3f6e51;font-size:11px;text-align:right;border-bottom:1.5px solid #2f7d4f;&#39;&gt;&lt;div&gt;PK, число&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;employee_id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;FK -&gt; Сотрудники&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;ON DELETE CASCADE&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;state&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;то же множество, что employees.work_state&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;started_at&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;дата-время&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;ended_at&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;дата-время&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;NULL — интервал открыт; открытый ровно один на сотрудника&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#2f7d4f;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="1480" y="700" width="300" height="170" as="geometry"/></mxCell>
        <mxCell id="tbl_employee_schedule_days" value="&lt;table style=&#39;border-collapse:collapse;width:100%;font-family:Helvetica;font-size:12px;&#39;&gt;&lt;tr style=&#39;background:#2f7d4f;color:#ffffff;font-weight:700;&#39;&gt;&lt;td colspan=&#39;2&#39; style=&#39;padding:5px 8px;border-bottom:1px solid #1c4f32;&#39;&gt;employee_schedule_days (график: план по дням)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#e6f2ea;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:700;border-bottom:1.5px solid #2f7d4f;&#39;&gt;id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#3f6e51;font-size:11px;text-align:right;border-bottom:1.5px solid #2f7d4f;&#39;&gt;&lt;div&gt;PK, число&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;employee_id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;FK -&gt; Сотрудники&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;ON DELETE CASCADE&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;day&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;дата&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;UNIQUE (employee_id, day); нет строки = день не заполнен&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;state&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;shift | day_off | vacation | sick&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;shift_start&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;время, nullable&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;shift_end&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;время, nullable&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;снимок времени из карточки; NULL при state ≠ shift&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;is_extra&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;флаг&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;разовая смена; хранится, но в интерфейсе не показывается&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#2f7d4f;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="1480" y="900" width="300" height="230" as="geometry"/></mxCell><mxCell id="tbl_emp_docs" value="&lt;table style=&#39;border-collapse:collapse;width:100%;font-family:Helvetica;font-size:12px;&#39;&gt;&lt;tr style=&#39;background:#2f7d4f;color:#ffffff;font-weight:700;&#39;&gt;&lt;td colspan=&#39;2&#39; style=&#39;padding:5px 8px;border-bottom:1px solid #1c4f32;&#39;&gt;Документы_сотрудника&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#e6f2ea;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:700;border-bottom:1.5px solid #2f7d4f;&#39;&gt;id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#3f6e51;font-size:11px;text-align:right;border-bottom:1.5px solid #2f7d4f;&#39;&gt;PK, число&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:600;&#39;&gt;employee_id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div style=&#39;font-weight:600;&#39;&gt;число&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;&#39;&gt;N:1 -&gt; Сотрудники, CASCADE&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;document_type&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка, UNIQUE(employee_id+document_type)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;file_name&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;file_data&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;текст (base64)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;uploaded_at&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;Дата&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#2f7d4f;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="1480" y="242" width="300" height="162" as="geometry"/></mxCell>
        <mxCell id="tbl_lead_numbers" value="&lt;table style='border-collapse:collapse;width:100%%;font-family:Helvetica;font-size:12px;'&gt;&lt;tr style='background:#8a8f98;color:#ffffff;font-weight:700;'&gt;&lt;td colspan='2' style='padding:5px 8px;border-bottom:1px solid #6b7079;'&gt;Номера_лидов — ОТМЕНЕНО&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f2f3f5;'&gt;&lt;td colspan='2' style='padding:5px 8px;color:#5a6b8c;font-size:11px;'&gt;Отменена владельцем 12.08.2026 при постановке страницы «Лиды»: загрузка файла создаёт строки сразу в Лиды (источник, линия, скрипт и офферы проставляются на партию), сырого пула номеров не будет. Связь «номер → источник» реализована напрямую как Лиды.source_id.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#ffffff;'&gt;&lt;td colspan='2' style='padding:5px 8px;color:#8a3c2a;font-size:11px;'&gt;Не реализовывать. Если понадобится история загрузок — заводить «Загрузки лидов» (партия: файл, дата, параметры, счётчики), а не сырой пул номеров.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#8a8f98;fillColor=#ffffff;spacing=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="1120" y="1057" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="tbl_lead_sources" value="&lt;table style=&#39;border-collapse:collapse;width:100%;font-family:Helvetica;font-size:12px;&#39;&gt;&lt;tr style=&#39;background:#2f7d4f;color:#ffffff;font-weight:700;&#39;&gt;&lt;td colspan=&#39;2&#39; style=&#39;padding:5px 8px;border-bottom:1px solid #1c4f32;&#39;&gt;Источники_лидов (sources)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#e6f2ea;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:700;border-bottom:1.5px solid #2f7d4f;&#39;&gt;ID_Источника&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#3f6e51;font-size:11px;text-align:right;border-bottom:1.5px solid #2f7d4f;&#39;&gt;PK, число&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:600;&#39;&gt;ID_Площадки&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div style=&#39;font-weight:600;&#39;&gt;число, NOT NULL&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;&#39;&gt;N:1 -&gt; Рекламные_площадки, RESTRICT&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;root_source (Корневой источник)&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;Город_Регион&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка, NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;Статус&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;строка, NOT NULL — &quot;Активен&quot;/&quot;Неактивен&quot;/&quot;Архив&quot;/&quot;Актуализация&quot;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;
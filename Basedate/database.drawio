        <mxCell id="tbl_tunnel_key_tokens" value="&lt;table style=&#39;border-collapse:collapse;width:100%;font-family:Helvetica;font-size:12px;&#39;&gt;&lt;tr style=&#39;background:#2f7d4f;color:#ffffff;font-weight:700;&#39;&gt;&lt;td colspan=&#39;2&#39; style=&#39;padding:5px 8px;border-bottom:1px solid #1c4f32;&#39;&gt;tunnel_key_tokens (одноразовые ссылки на выдачу)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#e6f2ea;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:700;border-bottom:1.5px solid #2f7d4f;&#39;&gt;id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#3f6e51;font-size:11px;text-align:right;border-bottom:1.5px solid #2f7d4f;&#39;&gt;&lt;div&gt;PK, число&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:600;&#39;&gt;employee_id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;FK -&amp;gt; Сотрудники&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;ON DELETE CASCADE&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;token_hash&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка, UNIQUE&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;sha256 самого токена. Токен живёт только в ссылке — утечка таблицы не даёт рабочих ссылок&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;created_at&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;дата-время&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:600;&#39;&gt;created_by&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;число, nullable&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;N:1 -&amp;gt; Сотрудники, SET NULL&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;expires_at&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;дата-время&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;срок из TUNNEL_LINK_TTL_HOURS, по умолчанию сутки&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;used_at&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;дата-время, nullable&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;ссылку открыли. Отличает «уже забирали» (возможен перехват) от «срок истёк»&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;revoked_at&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;дата-время, nullable&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;погашена перевыпуском, не дожидаясь срока&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#2f7d4f;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="1480" y="1160" width="300" height="240" as="geometry"/></mxCell>
              <mxCell id="tbl_phone_fix_reasons" value="&lt;table style=&#39;border-collapse:collapse;width:100%;font-family:Helvetica;font-size:12px;&#39;&gt;&lt;tr style=&#39;background:#2f7d4f;color:#ffffff;font-weight:700;&#39;&gt;&lt;td colspan=&#39;2&#39; style=&#39;padding:5px 8px;border-bottom:1px solid #1c4f32;&#39;&gt;phone_fix_reasons (причины, по которым номер не разобрался)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#e6f2ea;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:700;border-bottom:1.5px solid #2f7d4f;&#39;&gt;id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#3f6e51;font-size:11px;text-align:right;border-bottom:1.5px solid #2f7d4f;&#39;&gt;&lt;div&gt;PK, число&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;code&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;empty / letters / digits_lt_10 / ten_not_nine / eleven_foreign / digits_gt_11&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;title&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;название причины для человека&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;sort_order&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;число&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;порядок разбора: пусто &amp;#8594; буквы &amp;#8594; длина&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#2f7d4f;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="1480" y="2440" width="300" height="112" as="geometry"/></mxCell>
      <mxCell id="legend_states" value="&lt;table style='border-collapse:collapse;width:100%%;font-family:Helvetica;font-size:12px;'&gt;&lt;tr style='background:#2b2f36;color:#ffffff;font-weight:700;'&gt;&lt;td colspan='2' style='padding:5px 8px;'&gt;Обозначения&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px;background:#2f7d4f;width:18px;'&gt;&lt;/td&gt;&lt;td style='padding:4px 8px;font-size:11px;'&gt;Реализовано в БД (schema.sql) — источник правды&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px;background:#3f5b8f;'&gt;&lt;/td&gt;&lt;td style='padding:4px 8px;font-size:11px;'&gt;Запланировано, в БД пока нет&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px;background:#8a8f98;'&gt;&lt;/td&gt;&lt;td style='padding:4px 8px;font-size:11px;'&gt;Отменено — не реализовывать (пунктирная рамка)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='padding:5px 8px;font-size:11px;color:#5a6b8c;border-top:1px solid #d6dae2;'&gt;Схема догоняет реальную БД, а не наоборот. Любое изменение структуры (таблица, колонка, связь) синхронизируется здесь тем же коммитом, что и правка Backend/schema.sql.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='padding:5px 8px;font-size:11px;color:#5a6b8c;'&gt;Сверено с реальной БД 25.08.2026 (main 1990646): 38 сущностей на чертеже, в базе 52 таблицы — разница это 14 месячных секций audit_log, отдельными коробками они не рисуются.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#2b2f36;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="2620" width="420" height="200" as="geometry"/></mxCell>
        <mxCell id="tbl_app_settings" value="&lt;table style=&#39;border-collapse:collapse;width:100%;font-family:Helvetica;font-size:12px;&#39;&gt;&lt;tr style=&#39;background:#2f7d4f;color:#ffffff;font-weight:700;&#39;&gt;&lt;td colspan=&#39;2&#39; style=&#39;padding:5px 8px;border-bottom:1px solid #1c4f32;&#39;&gt;app_settings (настройки приложения)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#e6f2ea;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:700;border-bottom:1.5px solid #2f7d4f;&#39;&gt;key&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#3f6e51;font-size:11px;text-align:right;border-bottom:1.5px solid #2f7d4f;&#39;&gt;&lt;div&gt;PK, строка&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;value&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;текст&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;updated_at&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;дата и время&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#2f7d4f;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="520" y="2620" width="320" height="110" as="geometry"/></mxCell>

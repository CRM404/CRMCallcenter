        <mxCell id="tbl_employee_state_intervals" value="&lt;table style=&#39;border-collapse:collapse;width:100%;font-family:Helvetica;font-size:12px;&#39;&gt;&lt;tr style=&#39;background:#2f7d4f;color:#ffffff;font-weight:700;&#39;&gt;&lt;td colspan=&#39;2&#39; style=&#39;padding:5px 8px;border-bottom:1px solid #1c4f32;&#39;&gt;employee_state_intervals (таймеры состояний)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#e6f2ea;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:700;border-bottom:1.5px solid #2f7d4f;&#39;&gt;id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#3f6e51;font-size:11px;text-align:right;border-bottom:1.5px solid #2f7d4f;&#39;&gt;&lt;div&gt;PK, число&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;employee_id&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;FK -&gt; Сотрудники&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;ON DELETE CASCADE&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;state&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;строка&lt;/div&gt;&lt;div style=&#39;color:#8a3c2a;font-size:10px;font-weight:400;&#39;&gt;то же множество, что employees.work_state&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f7f8fb;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;started_at&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;дата-время&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#ffffff;&#39;&gt;&lt;td style=&#39;padding:3px 8px;font-weight:400;&#39;&gt;ended_at&lt;/td&gt;&lt;td style=&#39;padding:3px 8px;color:#7a7a7a;font-size:11px;text-align:right;&#39;&gt;&lt;div&gt;дата-время&
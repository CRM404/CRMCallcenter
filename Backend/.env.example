# Скопируйте в .env и заполните реальными значениями для локальной разработки.
# На Railway эти переменные задаются через вкладку Variables сервиса, .env там не используется.

DATABASE_URL=postgresql://postgres:password@localhost:5432/crm_dev
PORT=3000

# --- Туннель для операторов из-за границы (задача «Звонки», части 1 и 1Б) ---
#
# Это свойства КОНКРЕТНОГО сервера, а не проекта: в репозитории им делать
# нечего, поэтому они здесь только примером. Реальные значения берутся из
# /etc/wireguard/wg0.conf боевого сервера и ставятся в его .env.
#
# Без первых четырёх выдача ключа отвечает отказом и объясняет, чего не хватает:
# молча выдать ключ, который никуда не подключится, было бы хуже.
#
# TUNNEL_SERVER_PUBLIC_KEY — ОТКРЫТЫЙ ключ сервера (не закрытый!). Секретом не
#   является: он лежит в настройке у каждого оператора. Закрытый ключ сервера
#   в переменные окружения не попадает никогда.
# TUNNEL_ENDPOINT — куда стучится клиент: адрес и порт через двоеточие.
# TUNNEL_DNS      — резолверы, которые оператор получает вместе с туннелем.
#   Через запятую. Свои, а не публичные: трафик и так идёт через наш сервер.
# TUNNEL_SUBNET   — подсеть туннеля. Первый адрес — сама сеть, второй занят
#   сервером, людям раздаются остальные.
TUNNEL_SERVER_PUBLIC_KEY=
TUNNEL_ENDPOINT=vpn.example.org:443
TUNNEL_DNS=192.0.2.53, 192.0.2.54
TUNNEL_SUBNET=10.77.0.0/24

# Необязательные — умолчания стоят те, что проверены на живом операторе.
# TUNNEL_MTU=1280               меньше стандартных 1500: пакет туннеля едет
#                               внутри другого пакета, и при 1500 звонок
#                               соединяется, а голоса нет — самая частая беда.
# TUNNEL_KEEPALIVE=25           оператор за домашним роутером: без
#                               периодического пакета NAT забывает соответствие
#                               и входящий звонок не доходит.
# TUNNEL_ALLOWED_IPS=0.0.0.0/0  весь трафик через туннель, не только телефония.
# TUNNEL_LINK_TTL_HOURS=24      сколько живёт одноразовая ссылка на выдачу.
#                               Решение владельца 23.08.2026 — сутки.

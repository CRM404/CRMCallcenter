# Скопируйте в .env и заполните реальными значениями для локальной разработки.
# НА БОЮ .env НЕ ИСПОЛЬЗУЕТСЯ: с 23.08.2026 проект живёт на своём сервере, и
# переменные лежат в /etc/crm/env (640, root:crmapp). Прежняя строка называла
# здесь Railway — он всё ещё поднят с КОПИЕЙ тех же данных, и правка там ушла
# бы в никуда, выглядя при этом успешной.

DATABASE_URL=postgresql://postgres:password@localhost:5432/crm_dev
PORT=3000

# SSL до базы включается ТОЛЬКО значением require — сравнение в коде строгое
# (db.js). Любое другое значение, включая true, 1 и yes, читается как «без SSL»,
# и читается молча: соединение поднимется, а шифрования не будет. Локально и на
# своём сервере база рядом, поэтому строка закомментирована.
# PGSSL=require

# Ключ подсказок адресов (DaData). Без него подсказки региона и населённого
# пункта отвечают отказом — сам раздел при этом работает.
DADATA_API_KEY=

# --- Туннель для операторов из-за границы (задача «Звонки», части 1 и 1Б) ---
#
# Это свойства КОНКРЕТНОГО сервера, а не проекта: в репозитории им делать
# нечего, поэтому они здесь только примером. Реальные значения берутся из
# /etc/wireguard/wg0.conf боевого сервера и ставятся в его .env.
#
# Без первых четырёх выдача ключа отвечает отказом и объясняет, чего не хватает:
# молча выдать ключ, который никуда не подключится, было бы хуже.
#
# TUNNEL_SERVER_PUBLIC_KEY — ОТКРЫТЫЙ ключ сервера (не закрытый!). Секретом не
#   является: он лежит в настройке у каждого оператора. Закрытый ключ сервера
#   в переменные окружения не попадает никогда.
# TUNNEL_ENDPOINT — куда стучится клиент: адрес и порт через двоеточие.
# TUNNEL_DNS      — резолверы, которые оператор получает вместе с туннелем.
#   Через запятую. Свои, а не публичные: трафик и так идёт через наш сервер.
# TUNNEL_SUBNET   — подсеть туннеля. Первый адрес — сама сеть, второй занят
#   сервером, людям раздаются остальные.
TUNNEL_SERVER_PUBLIC_KEY=
TUNNEL_ENDPOINT=vpn.example.org:443
TUNNEL_DNS=192.0.2.53, 192.0.2.54
TUNNEL_SUBNET=10.77.0.0/24

# Необязательные — умолчания стоят те, что проверены на живом операторе.
# TUNNEL_MTU=1280               меньше стандартных 1500: пакет туннеля едет
#                               внутри другого пакета, и при 1500 звонок
#                               соединяется, а голоса нет — самая частая беда.
# TUNNEL_KEEPALIVE=25           оператор за домашним роутером: без
#                               периодического пакета NAT забывает соответствие
#                               и входящий звонок не доходит.
# TUNNEL_ALLOWED_IPS=0.0.0.0/0  весь трафик через туннель, не только телефония.
# TUNNEL_LINK_TTL_HOURS=24      сколько живёт одноразовая ссылка на выдачу.
#                               Решение владельца 23.08.2026 — сутки.

# --- Работа по расписанию (задача «Звонки», часть 6) ------------------------
#
# Планировщик внутри приложения: раз в минуту разбирает очередь, чтобы лид с
# наступившим временем перезвона не ждал, пока его разбудит чужое событие.
#
# ВЫКЛЮЧЕН ПО УМОЛЧАНИЮ, и включается ровно значением true. Причины две.
# Первая: свежая установка не должна сама трогать данные. Вторая важнее — сегодня
# установок ДВЕ, Railway всё ещё поднят с копией тех же данных; база у него своя,
# значит и замок свой, и без этой переменной он раздавал бы лидов в копии.
#
# Один тик на всю установку держит замок в базе, а не эта переменная: два
# процесса с SCHEDULER_ENABLED=true на ОДНОЙ базе договорятся между собой сами.
# SCHEDULER_ENABLED=true

# --- Телефония: ключи приложения (задача «Звонки», часть 6, В5) -------------
#
# ЗДЕСЬ ТОЛЬКО ИМЕНА. Значения живут в /etc/crm/env боевого сервера (640,
# root:crmapp) и никогда — в базе и в коде: секрет, попавший в базу, попадает в
# резервную копию и в журнал изменений, а журнал этого проекта хранится
# бессрочно.
#
# Клиента авторизации в проекте пока НЕТ, и это решение, а не забывчивость
# (ответ куратора И146): ключей ещё не получили, и написанный сегодня клиент был
# бы ни разу не проверен — а непроверенному коду авторизации верят, и в этом его
# опасность. Он появится вместе с частью, которая им пользуется.
#
# Токен приложения живёт час и обновляется сам; trusted-приложению refresh-токен
# не выдаётся — новый берётся по этим же учётным данным.
# ⚠⚠ ПЕРЕНЕСЕНО В НАСТРОЙКИ (задача 57, решение владельца 132).
# Два ключа теперь живут на экране настроек и лежат в таблице `pbx_credentials`.
# Окружение ОСТАЁТСЯ ЗАПАСНЫМ источником и читается, когда настройка пуста,
# поэтому строки НЕ СНЯТЫ: порядок — сначала настройки, потом эти переменные (`routes/calls.js`).
TELPHIN_APP_ID=
TELPHIN_APP_SECRET=
# Адрес API подтверждён владельцем 25.08.2026 (решение 78). Резервный —
# altapi.telphin.ru.
TELPHIN_API_BASE=https://apiproxy.telphin.ru/api/ver1.0/
